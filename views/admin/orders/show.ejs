<%- include('../../partials/admin/head') %>
<div class="admin-form__grid">
  <div class="stack">
    <section class="admin-block">
      <div class="section__head"><h2>Pedido <span class="mono"><%= order.reference %></span></h2><span class="badge badge--status-<%= order.status %> badge--lg"><%= statusLabel(order.status) %></span></div>
      <div class="table-wrap"><table class="table table--compact"><thead><tr><th>Ítem</th><th>Tipo</th><th>Precio</th></tr></thead><tbody>
        <% items.forEach(function (it) { %><tr><td><%= it.title %></td><td><%= it.item_type === 'plan' ? 'Membresía' : 'Producto' %></td><td class="mono"><%= money(it.unit_cents) %></td></tr><% }) %>
      </tbody><tfoot><tr><th colspan="2">Total</th><th class="mono"><%= money(order.amount_cents) %></th></tr></tfoot></table></div>
    </section>
    <section class="admin-block">
      <h2>Datos del proveedor</h2>
      <ul class="buy-box__facts"><li><span>Método</span><strong><%= providerLabel(order.provider) %></strong></li><li><span>Referencia externa</span><strong class="mono"><%= order.provider_ref || '—' %></strong></li><% if (order.data.btc_amount) { %><li><span>Monto BTC</span><strong class="mono"><%= order.data.btc_amount %></strong></li><% } %><% if (order.data.claimed_at) { %><li><span>Cliente avisó</span><strong><%= fmtDateTime(order.data.claimed_at) %> <% if (order.data.txid) { %><span class="mono">txid: <%= order.data.txid %></span><% } %></strong></li><% } %></ul>
      <details class="mt-2"><summary class="text-muted">JSON completo</summary><pre class="code-block mono"><%= JSON.stringify(order.data, null, 2) %></pre></details>
    </section>
  </div>
  <aside class="stack">
    <section class="admin-block">
      <h2>Cliente</h2>
      <ul class="buy-box__facts"><li><span>Nombre</span><strong><%= order.user_name || '—' %></strong></li><li><span>Correo</span><strong><%= order.user_email || '—' %></strong></li><li><span>Creado</span><strong><%= fmtDateTime(order.created_at) %></strong></li><% if (order.paid_at) { %><li><span>Pagado</span><strong><%= fmtDateTime(order.paid_at) %></strong></li><% } %></ul>
    </section>
    <% if (order.status === 'pending') { %>
    <section class="admin-block">
      <h2>Acciones</h2>
      <form class="form" method="post" action="/admin/pedidos/<%= order.id %>/marcar-pagado" data-confirm="¿Confirmas que el pago fue recibido? Se activarán las descargas del cliente.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label class="label" for="note">Nota interna (opcional)</label><input class="input" id="note" name="note" placeholder="Verificado en la blockchain / Yape recibido…"></div>
        <button class="btn btn--mint btn--block" type="submit">Marcar como pagado</button>
      </form>
      <form method="post" action="/admin/pedidos/<%= order.id %>/cancelar" class="mt-2" data-confirm="¿Cancelar este pedido?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--danger btn--block" type="submit">Cancelar pedido</button></form>
    </section>
    <% } %>
    <a class="btn btn--ghost btn--block" href="/admin/pedidos">Volver a pedidos</a>
  </aside>
</div>
<%- include('../../partials/admin/footer') %>
