<%- include('../../partials/admin/head') %>
<form class="admin-toolbar" method="get"><div class="cluster"><input class="input input--sm" type="search" name="q" placeholder="Buscar por nombre o correo…" value="<%= q %>"><button class="btn btn--secondary btn--sm" type="submit">Buscar</button></div><span class="mono text-muted"><%= total %> usuarios</span></form>
<div class="table-wrap"><table class="table">
  <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Compras</th><th>Registro</th><th></th></tr></thead>
  <tbody>
    <% rows.forEach(function (u) { %>
      <tr><td><%= u.name %></td><td><%= u.email %></td><td><span class="badge <%= u.role === 'admin' ? 'badge--sale' : 'badge--cat' %>"><%= u.role %></span></td><td class="mono"><%= u.paid_orders %></td><td><%= fmtDate(u.created_at) %></td>
        <td><form method="post" action="/admin/usuarios/<%= u.id %>/rol" class="cluster cluster--tight"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="role" value="<%= u.role === 'admin' ? 'user' : 'admin' %>"><button class="btn btn--ghost btn--sm" type="submit" <%= u.id === currentUser.id ? 'disabled' : '' %>><%= u.role === 'admin' ? 'Quitar admin' : 'Hacer admin' %></button></form></td></tr>
    <% }) %>
  </tbody>
</table></div>
<%- include('../../partials/admin/footer') %>
