<%- include('../../partials/admin/head') %>
<% if (errors.length) { %><div class="alert alert--error"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div><% } %>
<form class="form admin-form" method="post" action="<%= bundle ? `/admin/paquetes/${bundle.id}/editar` : '/admin/paquetes/nuevo' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="admin-form__grid">
    <section class="admin-block">
      <div class="form-grid">
        <div class="field"><label class="label" for="bu-name">Nombre</label><input class="input" id="bu-name" name="name" required value="<%= form.name || '' %>" data-slug-source></div>
        <div class="field"><label class="label" for="bu-slug">Slug</label><input class="input mono" id="bu-slug" name="slug" value="<%= form.slug || '' %>" data-slug-target></div>
        <div class="field field--span"><label class="label" for="bu-desc">Descripción</label><textarea class="textarea" id="bu-desc" name="description" rows="3"><%= form.description || '' %></textarea></div>
        <fieldset class="field field--span"><legend class="label">Productos incluidos (mínimo 2)</legend>
          <% allProducts.forEach(function (p) { %><label class="checkbox"><input type="checkbox" name="product_ids" value="<%= p.id %>" <%= (form.product_ids || []).includes(p.id) ? 'checked' : '' %>> <%= p.title %> <small class="text-muted mono"><%= money(effectivePrice(p)) %></small></label><% }) %>
        </fieldset>
      </div>
    </section>
    <aside class="stack">
      <section class="admin-block">
        <div class="field"><label class="label" for="bu-price">Precio del paquete (USD)</label><input class="input mono" id="bu-price" name="price" type="number" step="0.01" min="0" required value="<%= form.price_cents ? (form.price_cents / 100).toFixed(2) : '' %>"></div>
        <label class="checkbox"><input type="checkbox" name="is_active" value="1" <%= form.is_active ? 'checked' : '' %>> Activo</label>
      </section>
      <div class="form__actions"><button class="btn btn--primary btn--block btn--lg" type="submit"><%= bundle ? 'Guardar' : 'Crear paquete' %></button><a class="btn btn--ghost btn--block" href="/admin/paquetes">Volver</a></div>
    </aside>
  </div>
</form>
<%- include('../../partials/admin/footer') %>
