<% if (flash && flash.length) { %>
<div class="container flash-stack" role="status" aria-live="polite">
  <% flash.forEach(function (f) { %>
    <div class="alert alert--<%= f.type %>" data-flash><span><%= f.message %></span><button type="button" class="alert__close" aria-label="Cerrar" data-flash-close>×</button></div>
  <% }) %>
</div>
<% } %>
