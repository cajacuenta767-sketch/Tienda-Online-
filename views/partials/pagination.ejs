<% if (pages > 1) { const mk = (n) => { const u = new URL(basePath, 'http://x'); Object.entries(query || {}).forEach(([k, v]) => { if (v) u.searchParams.set(k, v); }); u.searchParams.set('page', n); return u.pathname + u.search; }; %>
<nav class="pagination" aria-label="Paginación">
  <a class="btn btn--ghost btn--sm <%= page <= 1 ? 'is-disabled' : '' %>" href="<%= mk(Math.max(1, page - 1)) %>" <%= page <= 1 ? 'aria-disabled="true" tabindex="-1"' : '' %>>← Anterior</a>
  <span class="pagination__info mono">Página <%= page %> de <%= pages %></span>
  <a class="btn btn--ghost btn--sm <%= page >= pages ? 'is-disabled' : '' %>" href="<%= mk(Math.min(pages, page + 1)) %>" <%= page >= pages ? 'aria-disabled="true" tabindex="-1"' : '' %>>Siguiente →</a>
</nav>
<% } %>
