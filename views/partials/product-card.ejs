<% const pct = discountPct(product); %>
<article class="product-card">
  <a class="product-card__media" href="/producto/<%= product.slug %>">
    <img src="<%= product.image || '/img/placeholder.svg' %>" alt="<%= product.title %>" loading="lazy" width="640" height="400">
    <div class="product-card__badges">
      <% if (product.is_new) { %><span class="badge badge--new"><%= t('card.new') %></span><% } %>
      <% if (pct) { %><span class="badge badge--sale">-<%= pct %>%</span><% } %>
    </div>
  </a>
  <div class="product-card__fav"><%- include('fav-button', { product }) %></div>
  <div class="product-card__body">
    <div class="product-card__meta">
      <% if (product.category_name) { %><a class="badge badge--cat" href="/tienda/categoria/<%= product.category_slug %>"><%= product.category_name %></a><% } %>
      <span class="rating"><%- stars(product.rating_avg) %> <% if (product.rating_count) { %><strong><%= Number(product.rating_avg).toFixed(1) %></strong> (<%= product.rating_count %>)<% } else { %><span><%= t('card.noReviews') %></span><% } %></span>
    </div>
    <h3 class="product-card__title"><a href="/producto/<%= product.slug %>"><%= tr(product, 'title') %></a></h3>
    <p class="product-card__desc truncate-2"><%= tr(product, 'short_description') %></p>
    <div class="product-card__footer">
      <%- include('price', { product }) %>
      <span class="badge badge--version">v<%= product.version %></span>
    </div>
    <div class="product-card__actions">
      <% if (product.demo_url) { %><a class="btn btn--secondary btn--sm" href="/demo/<%= product.slug %>"><%= t('card.demo') %></a><% } %>
      <a class="btn btn--ghost btn--sm" href="/producto/<%= product.slug %>"><%= t('card.details') %></a>
      <a class="btn btn--primary btn--sm" href="/pagar?producto=<%= product.slug %>"><%= t('card.buy') %></a>
      <button type="button" class="btn btn--ghost btn--sm compare-btn" data-compare="<%= product.slug %>" title="<%= t('product.compare') %>" aria-label="<%= t('product.compare') %>">⇄</button>
    </div>
  </div>
</article>
