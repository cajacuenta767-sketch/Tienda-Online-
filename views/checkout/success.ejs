<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="section">
  <div class="container narrow">
    <div class="result-card">
      <p class="mono text-mint">// <%= paid ? 'pago confirmado' : 'pago en proceso' %></p>
      <h1><%= paid ? '¡Gracias por tu compra!' : 'Estamos confirmando tu pago' %></h1>
      <p class="text-muted"><%= paid ? 'Tu pedido ' + order.reference + ' está pagado. Ya puedes descargar tus archivos.' : 'Stripe todavía no confirmó el pago del pedido ' + order.reference + '. Se activará automáticamente en cuanto se complete.' %></p>
      <div class="cluster"><a class="btn btn--primary" href="/pedidos/<%= order.id %>">Ver pedido</a><a class="btn btn--secondary" href="/cuenta?tab=descargas">Mis descargas</a></div>
    </div>
  </div>
</section>
<%- include('../partials/footer') %>
