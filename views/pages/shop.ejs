<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="page-head">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Ruta"><a href="/">Inicio</a><% breadcrumb.forEach(function (b) { %><span>/</span><% if (b.href) { %><a href="<%= b.href %>"><%= b.label %></a><% } else { %><span aria-current="page"><%= b.label %></span><% } %><% }) %></nav>
    <div class="page-head__row">
      <div><h1><%= title %></h1><p class="text-muted"><%= subtitle %></p></div>
      <span class="mono text-muted"><%= result.total %> resultado<%= result.total === 1 ? '' : 's' %></span>
    </div>
  </div>
</section>
<section class="section section--tight">
  <div class="container">
    <div class="filter-bar">
      <div class="filter-bar__chips">
        <a class="tag-chip <%= !activeCategory && !activeTag ? 'is-active' : '' %>" href="/tienda<%= q ? '?q=' + encodeURIComponent(q) : '' %>">Todo</a>
        <% categories.forEach(function (c) { %><a class="tag-chip <%= activeCategory === c.slug ? 'is-active' : '' %>" href="/tienda/categoria/<%= c.slug %>"><%= c.name %> <small><%= c.product_count %></small></a><% }) %>
      </div>
      <form class="filter-bar__sort" method="get" action="<%= basePath %>">
        <% if (q) { %><input type="hidden" name="q" value="<%= q %>"><% } %>
        <label for="sort" class="sr-only">Ordenar</label>
        <select id="sort" name="sort" class="select select--sm" data-auto-submit>
          <option value="recent" <%= sort === 'recent' ? 'selected' : '' %>>Más recientes</option>
          <option value="popular" <%= sort === 'popular' ? 'selected' : '' %>>Más vendidos</option>
          <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Precio: menor a mayor</option>
          <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Precio: mayor a menor</option>
          <option value="name" <%= sort === 'name' ? 'selected' : '' %>>Nombre A–Z</option>
        </select>
      </form>
    </div>
    <% if (result.rows.length) { %>
      <div class="grid grid-3">
        <% result.rows.forEach(function (product) { %><%- include('../partials/product-card', { product }) %><% }) %>
      </div>
      <%- include('../partials/pagination', { page: result.page, pages: result.pages, basePath, query: { q, sort } }) %>
    <% } else { %>
      <div class="empty-state">
        <p class="mono">// sin resultados</p>
        <h2>No encontramos productos<%= q ? ` para «${q}»` : '' %></h2>
        <p>Prueba con otra búsqueda o explora todas las categorías.</p>
        <a class="btn btn--primary" href="/tienda">Ver toda la tienda</a>
      </div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
