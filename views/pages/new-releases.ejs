<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="page-head">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Ruta"><a href="/">Inicio</a><span>/</span><span aria-current="page">Nuevos lanzamientos</span></nav>
    <div class="page-head__row">
      <div><h1>Nuevos lanzamientos</h1><p class="text-muted">Productos publicados en los últimos 30 días o marcados como novedad. Actualizamos el catálogo cada semana.</p></div>
      <span class="mono text-muted"><%= result.total %> producto<%= result.total === 1 ? '' : 's' %></span>
    </div>
  </div>
</section>
<section class="section section--tight">
  <div class="container">
    <% if (result.rows.length) { %>
      <div class="grid grid-3"><% result.rows.forEach(function (product) { %><%- include('../partials/product-card', { product }) %><% }) %></div>
      <%- include('../partials/pagination', { page: result.page, pages: result.pages, basePath: '/nuevos', query: {} }) %>
    <% } else { %>
      <div class="empty-state"><p class="mono">// próximamente</p><h2>Aún no hay lanzamientos recientes</h2><a class="btn btn--primary" href="/tienda">Ver toda la tienda</a></div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
