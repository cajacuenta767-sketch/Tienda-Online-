<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="page-head">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Ruta"><a href="/">Inicio</a><span>/</span><a href="/paquetes">Paquetes</a><span>/</span><span aria-current="page"><%= bundle.name %></span></nav>
    <div class="page-head__row"><div><p class="eyebrow">Paquete · ahorra <%= bundle.savings_pct %>%</p><h1><%= bundle.name %></h1><p class="text-muted"><%= bundle.description %></p></div></div>
  </div>
</section>
<section class="section section--tight">
  <div class="container two-col">
    <div class="grid grid-2">
      <% bundle.products.forEach(function (p) { %>
        <article class="product-card">
          <a class="product-card__media" href="/producto/<%= p.slug %>"><img src="<%= p.image || '/img/placeholder.svg' %>" alt="<%= p.title %>"></a>
          <div class="product-card__body"><h3 class="product-card__title"><a href="/producto/<%= p.slug %>"><%= p.title %></a></h3><p class="product-card__desc truncate-2"><%= p.short_description %></p><div class="product-card__footer"><%- include('../partials/price', { product: p }) %><span class="badge badge--version">v<%= p.version %></span></div></div>
        </article>
      <% }) %>
    </div>
    <aside class="buy-box">
      <h2 class="buy-box__title"><%= bundle.name %></h2>
      <ul class="summary-list">
        <% bundle.products.forEach(function (p) { %><li><span><%= p.title %></span><span class="mono"><%= money(effectivePrice(p)) %></span></li><% }) %>
        <li class="is-discount"><span>Descuento del paquete</span><span class="mono">− <%= money(bundle.savings_cents) %></span></li>
      </ul>
      <div class="summary-total"><span>Total</span><span class="price__current" style="color:var(--primary)"><%= money(bundle.price_cents) %></span></div>
      <div class="buy-box__actions mt-3">
        <a class="btn btn--primary btn--lg btn--block" href="/pagar?paquete=<%= bundle.slug %>">Comprar el paquete</a>
        <% if (waEnabled) { %><a class="btn btn--whatsapp btn--block" href="https://wa.me/<%= settings.whatsapp_number %>?text=<%= encodeURIComponent('Hola, me interesa el paquete ' + bundle.name) %>" target="_blank" rel="noopener">Consultar por WhatsApp</a><% } %>
      </div>
      <p class="help text-muted">Incluye licencia y actualizaciones de cada producto.</p>
    </aside>
  </div>
</section>
<%- include('../partials/footer') %>
