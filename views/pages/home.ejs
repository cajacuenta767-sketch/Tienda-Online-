<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% const heroProduct = featured[0] || newest[0]; %>
<section class="hero">
  <div class="container">
    <div class="hero__grid">
      <div class="hero__copy">
        <p class="eyebrow"><%= settings.hero_eyebrow %></p>
        <h1 class="hero__title"><%- escapeHtml(settings.hero_title).replace(/\b(vender|instalar|crecer|negocio|software)\b/i, '<em>$1</em>') %></h1>
        <p class="hero__subtitle"><%= settings.hero_subtitle %></p>
        <div class="cluster hero__cta">
          <a class="btn btn--primary btn--lg" href="/tienda">Explorar la tienda</a>
          <a class="btn btn--secondary btn--lg" href="/membresia">Ver membresías</a>
        </div>
        <div class="hero__proof">
          <div class="avatars" aria-hidden="true"><span>JR</span><span>MA</span><span>LP</span><span>+</span></div>
          <span><strong><%= stats.users %></strong> clientes registrados · <strong><%= stats.sales %></strong> ventas · soporte en menos de 24 h</span>
        </div>
      </div>
      <div class="hero__visual">
        <% if (heroProduct) { %>
        <a class="mock" href="/producto/<%= heroProduct.slug %>" aria-label="Ver <%= heroProduct.title %>">
          <div class="mock__bar"><span></span><span></span><span></span><span class="mock__url">demo.<%= storeName.toLowerCase() %>.app/<%= heroProduct.slug %></span></div>
          <img src="<%= heroProduct.image || '/img/placeholder.svg' %>" alt="" width="1280" height="800">
        </a>
        <div class="float-chip float-chip--a"><span class="float-chip__icon">✓</span><div>Descarga inmediata<small>Código fuente completo</small></div></div>
        <div class="float-chip float-chip--b"><span class="float-chip__icon">★</span><div><%= heroProduct.rating_count ? Number(heroProduct.rating_avg).toFixed(1) + ' / 5' : 'Demo en vivo' %><small><%= heroProduct.rating_count ? heroProduct.rating_count + ' reseñas' : 'Pruébalo antes de comprar' %></small></div></div>
        <% } %>
      </div>
    </div>
    <dl class="hero__stats">
      <div><dt><%= stats.products %></dt><dd>sistemas, plantillas y scripts</dd></div>
      <div><dt><%= stats.updates %></dt><dd>actualizaciones publicadas</dd></div>
      <div><dt><%= stats.sales %></dt><dd>ventas realizadas</dd></div>
      <div><dt>24 h</dt><dd>tiempo máximo de respuesta</dd></div>
    </dl>
  </div>
</section>

<% if (featured.length) { %>
<section class="section">
  <div class="container">
    <div class="section__head">
      <div><p class="eyebrow">Selección</p><h2>Productos destacados</h2></div>
      <a class="link-more" href="/tienda">Ver toda la tienda →</a>
    </div>
    <div class="grid grid-4">
      <% featured.forEach(function (product) { %><%- include('../partials/product-card', { product }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section section--alt">
  <div class="container">
    <div class="section__head">
      <div><p class="eyebrow">Explora</p><h2>Categorías</h2></div>
    </div>
    <div class="grid grid-3">
      <% const icons = { 'sistemas-web': '</>', plantillas: '{ }', scripts: '$_' }; %>
      <% categories.forEach(function (c) { %>
        <a class="category-card" href="/tienda/categoria/<%= c.slug %>">
          <span class="category-card__icon"><%= icons[c.slug] || '#' %></span>
          <span class="category-card__count"><%= c.product_count %> productos</span>
          <h3><%= c.name %></h3>
          <p><%= c.description %></p>
          <span class="link-more">Ver productos →</span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<% if (newest.length) { %>
<section class="section">
  <div class="container">
    <div class="section__head">
      <div><p class="eyebrow">Recién publicados</p><h2>Nuevos lanzamientos</h2></div>
      <a class="link-more" href="/nuevos">Ver todos →</a>
    </div>
    <div class="grid grid-4">
      <% newest.forEach(function (product) { %><%- include('../partials/product-card', { product }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (plans.length) { %>
<section class="section section--alt" id="membresia">
  <div class="container">
    <div class="section__head">
      <div><p class="eyebrow">Ahorra</p><h2>Membresía: todo el catálogo por un solo pago</h2></div>
      <a class="link-more" href="/membresia">Comparar planes →</a>
    </div>
    <div class="grid grid-3 plans-grid">
      <% plans.forEach(function (plan) { %><%- include('../partials/plan-card', { plan }) %><% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section">
  <div class="container">
    <div class="section__head"><div><p class="eyebrow">Por qué elegirnos</p><h2>¿Por qué <%= storeName %>?</h2></div></div>
    <div class="grid grid-4 features-grid">
      <div class="feature-tile"><span class="feature-tile__icon"><%- include('../partials/icons', { icon: 'code' }) %></span><h3>Código fuente completo</h3><p>Sin ofuscación ni llamadas a servidores externos. Modifícalo, adáptalo y hazlo tuyo.</p></div>
      <div class="feature-tile"><span class="feature-tile__icon"><%- include('../partials/icons', { icon: 'refresh' }) %></span><h3>Actualizaciones incluidas</h3><p>Cada compra incluye las versiones futuras del producto. Revisa el historial en Actualizaciones.</p></div>
      <div class="feature-tile"><span class="feature-tile__icon"><%- include('../partials/icons', { icon: 'play' }) %></span><h3>Demo en vivo</h3><p>Prueba cada sistema antes de comprar, con datos de ejemplo y todas sus funciones.</p></div>
      <div class="feature-tile"><span class="feature-tile__icon"><%- include('../partials/icons', { icon: 'chat' }) %></span><h3>Soporte directo</h3><p>Hablas con quien escribió el código: WhatsApp y correo con respuesta en menos de 24 horas.</p></div>
    </div>
  </div>
</section>

<% if (testimonials.length) { %>
<section class="section section--alt">
  <div class="container">
    <div class="section__head"><div><p class="eyebrow">Opiniones</p><h2>Lo que dicen los clientes</h2></div></div>
    <div class="grid grid-3">
      <% testimonials.forEach(function (t) { %>
        <article class="testimonial">
          <%- stars(t.rating) %>
          <p class="testimonial__quote"><%= t.body %></p>
          <div class="testimonial__who"><span class="avatar" aria-hidden="true"><%= t.user_name.charAt(0).toUpperCase() %></span><div><strong><%= t.user_name %></strong><small>sobre <a href="/producto/<%= t.product_slug %>"><%= t.product_title %></a></small></div></div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (updates.length) { %>
<section class="section">
  <div class="container">
    <div class="section__head">
      <div><p class="eyebrow">Mantenimiento activo</p><h2>Últimas actualizaciones</h2></div>
      <a class="link-more" href="/actualizaciones">Ver historial →</a>
    </div>
    <ul class="update-list">
      <% updates.forEach(function (u) { %>
        <li class="update-row">
          <span class="badge badge--version">v<%= u.version %></span>
          <a class="update-row__title" href="/producto/<%= u.product_slug %>"><%= u.product_title %></a>
          <span class="update-row__notes text-muted"><%= truncate(lines(u.notes)[0] || '', 110) %></span>
          <time class="mono text-muted" datetime="<%= u.released_at %>"><%= fmtDate(u.released_at) %></time>
        </li>
      <% }) %>
    </ul>
  </div>
</section>
<% } %>

<section class="section section--tight">
  <div class="container cta-strip">
    <div>
      <h2>¿Necesitas algo a medida?</h2>
      <p>Adaptamos cualquiera de nuestros sistemas a tu negocio o desarrollamos uno desde cero.</p>
    </div>
    <div class="cluster">
      <% if (waEnabled) { %><a class="btn btn--whatsapp" href="https://wa.me/<%= settings.whatsapp_number %>?text=<%= encodeURIComponent('Hola ' + storeName + ', quiero cotizar un desarrollo a medida.') %>" target="_blank" rel="noopener">Escribir por WhatsApp</a><% } %>
      <a class="btn btn--secondary" href="/contacto">Formulario de contacto</a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
