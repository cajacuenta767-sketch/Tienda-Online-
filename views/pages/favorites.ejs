<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="page-head">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Ruta"><a href="/">Inicio</a><span>/</span><span aria-current="page">Favoritos</span></nav>
    <div class="page-head__row">
      <div><h1>Mis favoritos</h1><p class="text-muted"><%= currentUser ? 'Tus productos guardados, disponibles desde cualquier dispositivo.' : 'Se guardan en este navegador. Crea una cuenta para conservarlos siempre.' %></p></div>
      <span class="mono text-muted"><%= result.total %> guardado<%= result.total === 1 ? '' : 's' %></span>
    </div>
  </div>
</section>
<section class="section section--tight">
  <div class="container">
    <% if (result.rows.length) { %>
      <div class="grid grid-3"><% result.rows.forEach(function (product) { %><%- include('../partials/product-card', { product }) %><% }) %></div>
    <% } else { %>
      <div class="empty-state"><p class="mono">// lista vacía</p><h2>Aún no tienes favoritos</h2><p>Pulsa el corazón de cualquier producto para guardarlo aquí.</p><a class="btn btn--primary" href="/tienda">Explorar la tienda</a></div>
    <% } %>
  </div>
</section>
<%- include('../partials/footer') %>
