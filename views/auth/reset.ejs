<%- include('../partials/head') %>
<%- include('../partials/header') %>
<section class="section auth-section">
  <div class="container">
    <form class="form auth-card" method="post" action="/restablecer/<%= token %>" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p class="eyebrow">Casi listo</p>
      <h1>Nueva contraseña</h1>
      <% if (typeof errors !== 'undefined' && errors.length) { %><div class="alert alert--error"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div><% } %>
      <div class="field"><label class="label" for="n-pass">Contraseña nueva</label><input class="input" id="n-pass" name="password" type="password" autocomplete="new-password" minlength="8" required><span class="help">Mínimo 8 caracteres.</span></div>
      <div class="field"><label class="label" for="n-pass2">Repetir contraseña</label><input class="input" id="n-pass2" name="password_confirm" type="password" autocomplete="new-password" required></div>
      <button class="btn btn--primary btn--block btn--lg" type="submit">Guardar contraseña</button>
    </form>
  </div>
</section>
<%- include('../partials/footer') %>
