# Entorno
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
# Genera una cadena larga y aleatoria: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# Rutas de datos (en producción apunta a un disco persistente)
DB_PATH=./data/devmarket.sqlite
STORAGE_DIR=./storage/products
UPLOADS_DIR=./public/uploads
MAX_ZIP_MB=200
MAX_IMAGE_MB=5
CURRENCY=USD

# Administrador inicial (se crea en el primer arranque si no existe ningún admin)
ADMIN_EMAIL=admin@devmarket.local
ADMIN_PASSWORD=admin12345

# Datos de la tienda (editables luego desde /admin/ajustes)
STORE_NAME=DevMarket
WHATSAPP_NUMBER=51999999999
SUPPORT_EMAIL=soporte@devmarket.local
BTC_ADDRESS=
BTC_USD_RATE=60000
BTC_RATE_AUTO=false

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal (https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Culqi (Perú) — próximamente
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Correo saliente (SMTP). Si se deja vacío, los correos quedan en la bandeja interna del panel (Admin › Correos)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="DevMarket <no-reply@devmarket.local>"
# Exigir verificación de correo para comprar (true/false)
REQUIRE_EMAIL_VERIFICATION=false
# Minutos de validez de los enlaces de descarga firmados
DOWNLOAD_LINK_TTL_MIN=15
# Copias de seguridad (npm run backup)
BACKUP_DIR=./backups
BACKUP_KEEP=10
# Idioma por defecto: es | en
DEFAULT_LOCALE=es
